   "source": [
    "import torch\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    device = torch.device(\"cuda\")   # Windows RTX\n",
    "elif torch.backends.mps.is_available():\n",
    "    device = torch.device(\"mps\")    # Mac M4 Max\n",
    "else:\n",
    "    device = torch.device(\"cpu\")\n",
    "\n",
    "print(\"Using device:\", device)"
   ]
  }
